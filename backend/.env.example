# PrintX Backend Environment Variables
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="PrintX"
API_V1_PREFIX="/api/v1"

# Security
SECRET_KEY="printx-insecure-dev-secret-key-change-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM="HS256"

# Database
# Use sqlite+aiosqlite or standard sqlite for local dev
DATABASE_URL="sqlite:///./printx.db"

# Storage
STORAGE_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=50
DOCUMENT_RETENTION_HOURS=24

# Printer & Agent Defaults
DEFAULT_PRINTER_NAME="HP Smart Tank 580-590 series"
FALLBACK_PRINTER_NAME="Microsoft Print to PDF"
AGENT_SECRET_KEY="printx-agent-local-secret-key"

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

