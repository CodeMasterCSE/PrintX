# PrintX Windows Agent Configuration
BACKEND_API_URL="http://127.0.0.1:8000/api/v1"
AGENT_ID="AGENT-WIN11-01"
AGENT_SECRET="printx-agent-local-secret-key"

# Target Hardware Printer Name (Exact Windows Print Queue Name)
# Options: "HP Smart Tank 580-590 series", "HP5756E5 (HP Smart Tank 580-590 series)", "Microsoft Print to PDF"
TARGET_PRINTER_NAME="HP Smart Tank 580-590 series"
FALLBACK_PRINTER_NAME="Microsoft Print to PDF"

# Path to SumatraPDF executable (leave blank if in PATH or bundled in bin/)
SUMATRAPDF_PATH="./bin/SumatraPDF.exe"

# Polling & Heartbeat intervals (in seconds)
HEARTBEAT_INTERVAL_SECONDS=10
POLL_INTERVAL_SECONDS=3

# Safe retries and Spooler telemetry
MAX_RETRY_ATTEMPTS=2
SPOOLER_TIMEOUT_SECONDS=120

